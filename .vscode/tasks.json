{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sincronizar com GitHub (commit + push)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/sync.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Instalar dependências CrewAI",
      "type": "shell",
      "command": "pip install crewai python-dotenv",
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
